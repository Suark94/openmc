<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <cross_sections>2g.h5</cross_sections>
    <material id="1" name="mat_1">
      <density value="1.0" units="macro"/>
      <macroscopic name="mat_1"/>
    </material>
  </materials>
  <geometry>
    <cell id="1" material="1" region="-4 3 -6 5 -8 7" universe="0"/>
    <surface id="3" type="x-plane" boundary="reflective" coeffs="0.0"/>
    <surface id="4" type="x-plane" boundary="reflective" coeffs="10.0"/>
    <surface id="5" type="y-plane" boundary="reflective" coeffs="0.0"/>
    <surface id="6" type="y-plane" boundary="reflective" coeffs="10.0"/>
    <surface id="7" type="z-plane" boundary="reflective" coeffs="0.0"/>
    <surface id="8" type="z-plane" boundary="reflective" coeffs="10.0"/>
  </geometry>
  <settings>
    <run_mode>fixed source</run_mode>
    <particles>50</particles>
    <batches>10</batches>
    <inactive>5</inactive>
    <source type="independent" strength="1.0" particle="neutron">
      <space type="box">
        <parameters>0.0 0.0 0.0 10.0 10.0 10.0</parameters>
      </space>
      <energy type="discrete">
        <parameters>1000.0 1000000.0 2.0 8.0</parameters>
      </energy>
      <constraints>
        <domain_type>cell</domain_type>
        <domain_ids>1</domain_ids>
      </constraints>
    </source>
    <output>
      <summary>false</summary>
    </output>
    <energy_mode>multi-group</energy_mode>
    <tabular_legendre>
      <enable>false</enable>
    </tabular_legendre>
    <random_ray>
      <distance_active>50.0</distance_active>
      <distance_inactive>20.0</distance_inactive>
      <ray_source>
        <source type="independent" strength="1.0" particle="neutron">
          <space type="box">
            <parameters>0.0 0.0 0.0 10.0 10.0 10.0</parameters>
          </space>
        </source>
      </ray_source>
      <volume_estimator>naive</volume_estimator>
    </random_ray>
  </settings>
  <tallies>
    <filter id="1" type="energy">
      <bins>0.0 10000.0 2000000.0</bins>
    </filter>
    <tally id="1" name="total">
      <filters>1</filters>
      <scores>total</scores>
    </tally>
  </tallies>
</model>
